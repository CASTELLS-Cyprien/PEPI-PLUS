{% extends 'base.html.twig' %}

{% block title %}Détails de l'utilisateur -
	{{ user.firstName }}
	{{ user.lastName }}
{% endblock %}

{% block body %}
	<div
		class="min-h-screen bg-gray-100">
		{# Header #}
		<div class="bg-white shadow-sm border-b border-gray-200">
			<div class="sm:px-8 lg:px-8 py-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center space-x-3">
						<a href="{{ path('app_user_index') }}" class="text-gray-400 hover:text-gray-600"></a>
						<div>
							<h1 class="text-2xl font-bold text-gray-900">Profil Utilisateur</h1>
							<p class="mt-1 text-sm text-gray-500">ID:
								{{ user.id }}
								|
								{{ user.email }}</p>
						</div>
					</div>

					<div class="flex items-center space-x-3">
						<a href="{{ path('app_user_edit', {'id': user.id}) }}" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 border border-transparent rounded-md hover:bg-green-700">
							<twig:ux:icon name="cuida:edit-outline" class="w-5 h-5 mr-2"/>
							Modifier
						</a>
					</div>
				</div>
			</div>
		</div>

		{# Content #}
		<div class="sm:px-8 lg:px-8 py-8">
			<div class="bg-white shadow overflow-hidden sm:rounded-lg border border-gray-200">
				<div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
					<h3 class="text-lg leading-6 font-medium text-gray-900">Informations personnelles</h3>
				</div>
				<div class="px-4 py-5 sm:p-0">
					<dl
						class="sm:divide-y sm:divide-gray-200">

						{# Nom Complet #}
						<div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Identité</dt>
							<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
								<div class="font-medium text-gray-900">{{ user.firstName }}
									{{ user.lastName }}</div>
							</dd>
						</div>

						{# Email #}
						<div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Email</dt>
							<dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
								{{ user.email }}
							</dd>
						</div>

						{# Roles #}
						<div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Rôles</dt>
							<div class="flex flex-wrap gap-1">
								{% for role in user.roles %}
									{% if role != 'ROLE_USER' %}
										{% set roleName = "" %}
										{% set roleClass = "" %}

										{% if role == 'ROLE_ADMIN' %}
											{% set roleName = "Admin" %}
											{% set roleClass = "bg-purple-100 text-purple-800" %}
										{% elseif role == 'ROLE_PARTNER' %}
											{% set roleName = "Partenaire" %}
											{% set roleClass = "bg-yellow-100 text-yellow-800" %}
										{% elseif role == 'ROLE_COLLABORATOR' %}
											{% set roleName = "Collaborateur" %}
											{% set roleClass = "bg-blue-100 text-blue-800" %}
										{% else %}
											{% set roleName = role|replace({'ROLE_': ''})|capitalize %}
											{% set roleClass = "bg-gray-100 text-gray-800" %}
										{% endif %}

										<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {{ roleClass }}">
											{{ roleName }}
										</span>
									{% endif %}
								{% endfor %}
							</div>
						</div>

						{# Statut Actif #}
						<div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
							<dt class="text-sm font-medium text-gray-500">Statut du compte</dt>
							<dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
								{% if user.isActive %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
										Actif
									</span>
								{% else %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
										Inactif
									</span>
								{% endif %}
							</dd>
						</div>

					</dl>
				</div>


				<div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between rounded-b-lg">
					<a href="{{ path('app_user_index') }}" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
						<twig:ux:icon name="iconoir:arrow-left" class="w-4 h-4 mr-2"/>
						Retour à la liste des utilisateurs
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
