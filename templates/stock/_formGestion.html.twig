{# templates/stock/_formGestion.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div class="bg-white shadow-sm rounded-lg border border-gray-200">
	<div class="p-6 space-y-6">
		{{ form_errors(form) }}

		{% for child in form.children %}
			{# On masque le jeton CSRF et le champ partenaire car c'est un stock interne #}
			{% if child.vars.name != '_token' and child.vars.name != 'partner' %}
				<div class="form-group">
					{{ form_label(child, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
					{{ form_widget(child, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-colors'}}) }}
					{{ form_errors(child, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
				</div>
			{% endif %}
		{% endfor %}
	</div>

	<div class="bg-gray-50 px-6 py-4 border-t border-gray-200 flex items-center justify-between rounded-b-lg">
		<a href="{{ path('app_stock_gestion_index') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900">
			Annuler
		</a>
		<button type="submit" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-md hover:bg-green-700 transition-colors">
			<twig:ux:icon name="bi:check-lg" class="w-3 h-3 mr-2 inline"/>
			Enregistrer l'inventaire
		</button>
	</div>
</div>

{{ form_end(form) }}
