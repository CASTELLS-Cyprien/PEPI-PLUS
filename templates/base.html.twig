<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/x-icon" href="{{ asset('img/logoPepiPlusSFS.png') }}">
		<title>
			{% block title %}Pépi+ - Gestion de stock
			{% endblock %}
		</title>
		{# CSS compilé via Webpack Encore #}
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{# Google Fonts #}
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased flex min-h-screen bg-menthe-clair">
		{% if app.user %}
			{% include 'includes/sidebar.html.twig' %}
		{% endif %}
		<main
			class="flex-1 {% if app.user %}lg:ml-72{% endif %} min-h-screen">

			{# Section des Messages Flash #}
			<div class="fixed top-6 right-6 z-50 flex flex-col gap-3 max-w-sm w-full">
				{% for message in app.flashes('success') %}
					<div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg flex items-center shadow-lg gap-2">
						<twig:ux:icon name="bi:check-lg" class="w-5 h-5 shrink-0 text-green-500"/>
						<span class="text-sm font-medium">{{ message }}</span>
						<button onclick="this.parentElement.remove()" class="ml-auto text-green-400 hover:text-green-600">
							<twig:ux:icon name="bi:x" class="w-4 h-4"/>
						</button>
					</div>
				{% endfor %}

				{% for message in app.flashes('error') %}
					<div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg flex items-center shadow-lg gap-2">
						<twig:ux:icon name="iconoir:warning-circle" class="w-5 h-5 shrink-0 text-red-500"/>
						<span class="text-sm font-medium">{{ message }}</span>
						<button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-600">
							<twig:ux:icon name="bi:x" class="w-4 h-4"/>
						</button>
					</div>
				{% endfor %}

				{% for message in app.flashes('warning') %}
					<div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg flex items-center shadow-lg gap-2">
						<twig:ux:icon name="iconoir:warning-triangle" class="w-5 h-5 shrink-0 text-yellow-500"/>
						<span class="text-sm font-medium">{{ message }}</span>
						<button onclick="this.parentElement.remove()" class="ml-auto text-yellow-400 hover:text-yellow-600">
							<twig:ux:icon name="bi:x" class="w-4 h-4"/>
						</button>
					</div>
				{% endfor %}

				{% for message in app.flashes('danger') %}
					<div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg flex items-center shadow-lg gap-2">
						<twig:ux:icon name="iconoir:warning-circle" class="w-5 h-5 shrink-0 text-red-500"/>
						<span class="text-sm font-medium">{{ message }}</span>
						<button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-600">
							<twig:ux:icon name="bi:x" class="w-4 h-4"/>
						</button>
					</div>
				{% endfor %}
			</div>

			{% block body %}{% endblock %}
		</main>

		{% block javascripts %}
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			{# script preline #}
			<script src="https://cdn.jsdelivr.net/npm/preline/dist/preline.js"></script>
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
